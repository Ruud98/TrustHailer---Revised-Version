# Copy to .env and fill in. NEVER commit .env
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=
ALLOWED_HOSTS=trusthailer.co.za,www.trusthailer.co.za
CSRF_TRUSTED_ORIGINS=https://trusthailer.co.za,https://www.trusthailer.co.za
DATABASE_URL=postgres://user:pass@localhost:5432/trusthailer
REDIS_URL=redis://127.0.0.1:6379/1
ADMIN_URL=manage-a8f3c1/
SUPPORT_WHATSAPP=+27000000000

# Media (Cloudflare R2)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PRIVATE_BUCKET=

# Pricing — leave false to keep everything free
MONETISATION_ENABLED=false

# SMS (only used once PHONE_VERIFICATION_CHANNEL=sms)
PHONE_VERIFICATION_CHANNEL=manual
SMS_BACKEND=apps.accounts.sms.ClickatellSMSBackend
CLICKATELL_API_KEY=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@trusthailer.co.za
